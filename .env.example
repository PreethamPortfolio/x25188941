# Copy this file to .env and fill in all values before running the project..

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING="your_azure_connection_string_here"

# National Transport Authority (NTA) API
NTA_API_KEY="your_nta_api_key_here"

# PostgreSQL Database
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="transit_db"
DB_USER="postgres"
DB_PASSWORD="your_password"
